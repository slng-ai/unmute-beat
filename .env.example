# Required -------------------------------------------------------------------

# A Vertex AI Express Mode key. The model string is `google-cloud:`, so a plain
# Gemini Developer API key will not work.
GOOGLE_API_KEY=

# https://slng.ai -- one key for both STT and TTS.
SLNG_API_KEY=

# Optional: traces ------------------------------------------------------------
# With these, one call is one Langfuse trace: conversation -> turn -> stt, the
# agents' runs, tts. Without them the bot still runs and warns once.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Which Langfuse environment the traces land in. Unset is "default".
# LANGFUSE_TRACING_ENVIRONMENT=development

# Optional: the line and the voice --------------------------------------------
# CALLER_ID=+34600111222        # the number a phone call would arrive with
# SLNG_BASE_URL=eu-north.api.slng.ai          # the STT host
# SLNG_STT_MODEL=soniox/speech-ai:rt-v5
# SLNG_TTS_BASE_URL=eu-west.api.slng.ai       # the TTS host: Fish Audio, in Germany
# SLNG_TTS_MODEL=slng/fish/tts:s2.1-pro
# SLNG_TTS_VOICE=1258154bb41540c7b9dc0d10cd6704bf
# SLNG_STT_LANGUAGE=en          # speech languages; default is the flow's own (Faro: stt es, tts en)
# SLNG_TTS_LANGUAGE=en

# Optional: Faro (use-cases/faro-language-learning) ----------------------------
# LEARNING_DB_PATH=data/language_companion.sqlite3   # kept across calls and restarts
