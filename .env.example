# Required -------------------------------------------------------------------

# A Vertex AI Express Mode key. The model string is `google-cloud:`, so a plain
# Gemini Developer API key will not work.
GOOGLE_API_KEY=

# https://slng.ai -- one key for both STT and TTS.
SLNG_API_KEY=

# Optional: traces ------------------------------------------------------------
# With these, one call is one Langfuse trace: conversation -> turn -> stt, the
# agents' runs, tts. Without them the bot still runs and warns once.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: which agents, which voice ------------------------------------------
# HARNESS=voice runs the two-agent demo instead of the salon.
# HARNESS=salon
# CALLER_ID=+34600111222        # the number a phone call would arrive with
# SLNG_BASE_URL=eu-north.api.slng.ai
# SLNG_STT_MODEL=slng/deepgram/nova:3-en
# SLNG_TTS_MODEL=cartesia/sonic:3.5
# SLNG_TTS_VOICE=62ae83ad-4f6a-430b-af41-a9bede9286ca
