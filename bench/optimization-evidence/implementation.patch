+    r'(?:yes|yeah|yep|yup|sure|okay|ok|right|correct|exactly|absolutely|go for it|go ahead|do it|'
+    r"that(?:'s| is) (?:right|correct)|yes[, ]+(?:that(?:'s| is) (?:right|correct|my number)))"
+    r'(?:[, ]+please)?[.! ]*',
+    re.IGNORECASE,
