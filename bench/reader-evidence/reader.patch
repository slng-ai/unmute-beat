+def usage_of(span: dict) -> dict:
+    """Canonical quantities; cached tokens are a subset, absent counts stay unknown."""
+    details = span.get("usageDetails") or span.get("usage") or {}
+    if not isinstance(details, dict):
+        details = {}
+
+    def first(*names):
+        for name in names:
+            value = details.get(name)
+            if (
+                isinstance(value, (int, float))
+                and not isinstance(value, bool)
+                and math.isfinite(value)
+                and value >= 0
+            ):
+                return int(value)
+        return None
+
+    characters = first("characters")
+    if characters is not None:
+        return {
+            "input": characters,
+            "output": None,
+            "cached": None,
+            "total": characters,
+            "unit": "characters",
+        }
+    cached = first(
+        "input_cached_tokens",
+        "cached_content_tokens",
+        "cache_read_input_tokens",
+        "cached_tokens",
+    )
+    prompt = first("text_prompt_tokens", "prompt_tokens", "promptTokens")
+    if prompt is None:
+        uncached = first("input", "input_tokens")
+        if uncached is not None:
+            prompt = uncached + (cached or 0)
+    output = first(
+        "output",
+        "text_candidates_tokens",
+        "completion_tokens",
+        "completionTokens",
+        "output_tokens",
+    )
+    return {
+        "input": prompt,
+        "output": output,
+        "cached": cached,
+        "total": prompt + output if prompt is not None and output is not None else None,
+        "unit": "tokens",
+    }
+
